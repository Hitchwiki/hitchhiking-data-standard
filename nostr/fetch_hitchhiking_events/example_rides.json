    "content": "{\"version\":\"0.0.0\",\"stops\":[{\"location\":{\"latitude\":47.02231260039978,\"longitude\":15.494671089260152,\"is_exact\":true},\"departure_time\":\"2026-04-30T20:00:00\",\"waiting_duration\":\"PT100M\"},{\"location\":{\"latitude\":47.0963880360914,\"longitude\":15.98316772375256,\"is_exact\":false}}],\"rating\":1,\"hitchhikers\":[{\"nickname\":\"Anonymous\"},{\"nickname\":\"Anonymous\"}],\"comment\":\"THIS PLACE SHOULD NOT BE ON HITCHWIKI. We went there - super difficult - clime through a fence directly into the highway. BUT It's illegal to hitchhike on highway in Austria. Tried to hitchhike for 5 minuttes and then went to the start of the highway where the police came. Someone had called the police on us. Luckily we had gotten of the highway. Ended up after almost 2 hours to get a 20 minutes ride by a drunk guy. AUSTRIA is not the place to hitchhike.\",\"signals\":[{\"methods\":[\"sign\"],\"duration\":\"PT100M\"}],\"source\":\"maps.hitchwiki.org\",\"license\":\"xxx\",\"submission_time\":\"2026-05-01T09:23:17\"}",
