# Environment configuration for the Nostr hitchhiking-ride fetcher.
# Copy this file to .env and adjust the values:
#   cp example.env .env
# The script loads this .env automatically (via dotenv) when run directly.

# --- Required ---------------------------------------------------------------

# Nostr relays to query, as a JSON array of websocket URLs.
# For testing you may use public relays like "wss://nos.lol" or "wss://relay.damus.io".
RELAYS=["wss://relay.maps.hitchwiki.org"]

# Nostr event kind used for hitchhiking rides.
NOSTR_EVENT_KIND=36820

# --- Optional ---------------------------------------------------------------

# Only fetch rides created at or after this point in time.
# Accepts an ISO 8601 date/datetime (e.g. 2026-01-01 or 2026-01-01T00:00:00Z)
# or a raw Unix timestamp in seconds. Omit to fetch the full ride history.
SINCE=2026-01-01

# Only fetch rides signed by these author public keys (hex), as a JSON array.
# Applied server-side as the Nostr "authors" filter, so the relays only return
# events from these trusted submitters. Omit to accept any author.
# The hex keys of known trusted submitters are listed in ../README.md:
# https://github.com/Hitchwiki/hitchhiking-data-standard/blob/main/nostr/README.md
PUBKEYS=["d17ff51bfc32d49217e8cb5bfa558a5a78e6cbe3ea4d947acbc7f11ca5c5dbd5","6623bb9cbae2220e94d5f7581e0fd926db5d67538a08a7f306768e978d4d142e"]

# Only keep rides published by this app/source. Matches the "source" field in
# each ride's content (maps.hitchwiki.org is the source written by this app).
# Omit to keep rides from every source.
SOURCE=maps.hitchwiki.org
